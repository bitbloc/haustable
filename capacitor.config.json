{
  "appId": "com.inthehaus.pos",
  "appName": "ONHAUS POS",
  "webDir": "dist",
  "server": {
    "androidScheme": "http"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#F8F7F4",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "SunmiPrinter": {
      "bindOnLoad": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  }
}