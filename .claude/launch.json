{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "pos-readonly-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:pos-preview"
