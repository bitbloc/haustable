    {
      "name": "pos-readonly-preview-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "posreadonly",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    }
  ]
