{
    "functions": {
        "api/link.js": {
            "includeFiles": "dist/index.html"
        }
    },
    "rewrites": [
        {
            "source": "/",
            "destination": "/api/link"
        },
        {
            "source": "/link",
            "destination": "/api/link"
        },
        {
            "source": "/link/",
            "destination": "/api/link"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}