{
    "functions": {
        "api/link.js": {
            "includeFiles": "dist/index.html"
        }
    },
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/",
            "destination": "/api/link"
        },
        {
            "source": "/link",
            "destination": "/api/link"
        },
        {
            "source": "/link/",
            "destination": "/api/link"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}