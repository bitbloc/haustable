# Environment variable names read by this project. Copy to `.env` for local dev.
# Never put real values in this file; it is committed.

# --- Vite build (browser bundle; anything VITE_* ships to every visitor) ---
# Supabase project URL
VITE_SUPABASE_URL=
# Supabase public anon key (public by design)
VITE_SUPABASE_KEY=
# Gemini key for receipt OCR in the browser (visible to anyone who loads the page)
VITE_GEMINI_API_KEY=

# --- Vercel serverless (api/*.js; set in Vercel project settings) ---
# EasySlip key for api/verify-slip.js when the request does not supply one
EASYSLIP_API_KEY=
# LINE Messaging API token for order notifications in api/send-order-email.js
LINE_CHANNEL_ACCESS_TOKEN=
# LINE group that receives order notifications
LINE_GROUP_ID=
# Resend key for order notification email
RESEND_API_KEY=
# Optional Discord webhook for order notifications
DISCORD_WEBHOOK_URL=
# Supabase URL used by api/send-order-email.js (same value as the Vite one)
# VITE_SUPABASE_URL=
# Service role key used server-side by api/send-order-email.js (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase edge function secrets (supabase secrets set; not read from this file) ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
# EasySlip key for verify-payment-slip, used when app_settings.easyslip_api_key is empty
# EASYSLIP_API_KEY=
# LINE token for send-line-notify
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE Official Account token for send-booking-ticket
LINE_CHANNEL_ACCESS_TOKEN_OA=
# Telegram bot token for telegram-report
TELEGRAM_BOT_TOKEN=
# Secret that telegram-report checks on incoming webhooks
TELEGRAM_HOOK_SECRET=
# Shared key callers must send to stock-api
STOCK_API_KEY=
# Gemini key for line-webhook
GEMINI_API_KEY=
# Notte key for makro-api
NOTTE_API_KEY=
